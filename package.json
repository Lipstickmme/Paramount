{
  "name": "paramount-logistics",
  "version": "1.0.0",
  "description": "Paramount Logistics website, shipment tracking API and operations desk",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node scripts/build-pages.js && node --watch server.js",
    "build": "node scripts/build-pages.js",
    "prestart": "node scripts/build-pages.js",
    "check:vercel": "node scripts/check-vercel-upload.js",
    "test": "node test/api.test.js",
    "test:browser": "node test/browser.test.js && node test/fallback.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "logistics",
    "freight",
    "shipment-tracking",
    "express",
    "supabase"
  ],
  "author": "Paramount Logistics",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "express": "^4.19.2"
  }
}
